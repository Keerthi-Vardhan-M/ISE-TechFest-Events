# Supabase (Server-side only for SERVICE_ROLE_KEY)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Cloudflare Turnstile (Bot protection)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# Admin CSV Export Secret (used in x-admin-secret header for GET /api/admin/export)
ADMIN_EXPORT_SECRET=replace-with-strong-random-secret

# Email Notifications (Resend - 3,000 free emails/month)
# Sign up at https://resend.com and grab your API key
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=Automate x Quant <onboarding@resend.dev>


